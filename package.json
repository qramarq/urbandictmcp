{
  "name": "urbandictmcp",
  "version": "0.2.0",
  "description": "Dependency-free slang lookup, interpretation, and glossary rewriting for JavaScript and MCP.",
  "main": "server.js",
  "bin": {
    "urbandictmcp": "./server.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js && node scripts/smoke-test.js",
    "start": "node server.js",
